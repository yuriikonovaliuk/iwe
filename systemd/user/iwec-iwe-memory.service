[Unit]
Description=IWE MCP HTTP daemon for iwe-memory

[Service]
Type=simple
# The store account has no usable lingering user manager on this host, so this
# user-manager service deliberately drops to it through the existing narrow
# NOPASSWD sudo rule.  See docs/iwec-shared-daemon.md.
ExecStart=/usr/bin/sudo -n -u iwe-store /usr/local/lib/iwe-store/bin/iwec --transport http --host 127.0.0.1 --port 8765 --store /home/yurii/projects/iwe-memory
Environment=KC_IWE_BIN=/usr/local/lib/iwe-store/bin/iwe IWEC_IWE_BIN=/usr/local/lib/iwe-store/bin/iwe IWE_REQUIRE_STORE_MARKER=1 TMPDIR=/tmp
StandardOutput=journal
StandardError=journal
MemoryMax=1500M
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
